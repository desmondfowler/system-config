{
  "git.addAICoAuthor": "off",
  "database-client.autoSync": true,
  "sqldeveloper.sqlHistory.historyLimit": 500,
  "sqldeveloper.telemetry.enabled": false,
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
  },
  "diffEditor.maxComputationTime": 0,
  "sqldeveloper.datagrid.fontFamily": "Consolas, 'Courier New', monospace",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "python.defaultInterpreterPath": "/usr/bin/python",
  "python.analysis.typeCheckingMode": "standard",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "markdown.extension.tableFormatter.normalizeIndentation": true,
  "prettier.bracketSameLine": true,
  "prettier.printWidth": 120,
  "prettier.htmlWhitespaceSensitivity": "ignore",
  "chat.editor.preferCopilotHarness": false,
  "github.copilot.enable": {
    "markdown": true,

    "plaintext": true,
  },
  "chat.viewSessions.orientation": "stacked",
  "editor.accessibilitySupport": "off",
  "[oracle-sql]": {
    "editor.snippetSuggestions": "bottom",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "chat.plugins.marketplaces": ["github/awesome-copilot#marketplace", "https://github.com/mattpocock/skills"],
  "github.copilot.chat.exploreAgent.enabled": true,
  "editor.wordWrap": "on",
  "redhat.telemetry.enabled": false,
  "claudeCode.preferredLocation": "panel",

  "workbench.colorCustomizations": {
    "terminal.background": "#1d2021",
    "terminal.foreground": "#ebdbb2",
    "terminal.ansiBlack": "#1d2021",
    "terminal.ansiBrightBlack": "#928374",
    "terminal.ansiRed": "#cc241d",
    "terminal.ansiBrightRed": "#fb4934",
    "terminal.ansiGreen": "#98971a",
    "terminal.ansiBrightGreen": "#b8bb26",
    "terminal.ansiYellow": "#d79921",
    "terminal.ansiBrightYellow": "#fabd2f",
    "terminal.ansiBlue": "#458588",
    "terminal.ansiBrightBlue": "#83a598",
    "terminal.ansiMagenta": "#b16286",
    "terminal.ansiBrightMagenta": "#d3869b",
    "terminal.ansiCyan": "#689d6a",
    "terminal.ansiBrightCyan": "#8ec07c",
    "terminal.ansiWhite": "#a89984",
    "terminal.ansiBrightWhite": "#ebdbb2",
  },
  "terminal.integrated.minimumContrastRatio": 1,
  "workbench.colorTheme": "Gruvbox Dark Hard",
  "claudeCode.hideOnboarding": true,
}
