#!/usr/bin/env bash
LOGFILE=/tmp/eso-kill-launcher.log
echo "$(date) script started" >> "$LOGFILE"

TIMEOUT=120
INTERVAL=3
elapsed=0

# True if $1 is this script or one of its ancestors. eso-launch execs the game
# command, so that command's line can mention eso64.exe without being the game.
is_own_lineage() {
    local pid=$$
    while [[ -n "$pid" && "$pid" -gt 1 ]]; do
        [[ "$pid" == "$1" ]] && return 0
        pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    done
    return 1
}

eso_running() {
    local pid
    for pid in $(pgrep -f 'eso64\.exe'); do
        is_own_lineage "$pid" || return 0
    done
    return 1
}

while ! eso_running; do
    sleep "$INTERVAL"
    elapsed=$((elapsed + INTERVAL))
    if [[ $elapsed -ge $TIMEOUT ]]; then
        echo "$(date) timed out" >> "$LOGFILE"
        exit 1
    fi
done

echo "$(date) eso64.exe detected, killing launcher..." >> "$LOGFILE"
pkill -f 'bufferselfpatchfix'
echo "$(date) pkill exit code: $?" >> "$LOGFILE"
