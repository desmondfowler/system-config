#!/usr/bin/env bash
set -Eeuo pipefail

log() {
  printf '\n==> %s\n' "$*"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1
}

fedup_errors=0
note_error() {
  echo "ERROR: $*"
  fedup_errors=1
}

if [[ $EUID -eq 0 ]]; then
  echo "Run this as your normal user, not root."
  exit 1
fi

log "Refreshing and upgrading system packages"
sudo dnf5 upgrade --refresh -y || note_error "dnf5 upgrade failed"

log "Updating Flatpaks (user)"
if need_cmd flatpak; then
  flatpak update -y --user || note_error "flatpak user update failed"
else
  echo "flatpak not installed; skipping"
fi

log "Updating Flatpaks (system)"
if need_cmd flatpak; then
  sudo flatpak update -y --system || note_error "flatpak system update failed"
fi

log "Removing unused Flatpak runtimes"
if need_cmd flatpak; then
  flatpak uninstall --unused -y --user || true
  sudo flatpak uninstall --unused -y --system || true
fi

log "Removing orphaned system packages"
sudo dnf5 autoremove -y || true

# log "Upgrading firmware"
# if need_cmd fwupdmgr; then
#   fwupdmgr refresh --force || true
#   fwupdmgr get-updates || true
#   sudo fwupdmgr update || note_error "fwupdmgr update failed"
# fi

log "Checking whether a reboot is needed"
needs_reboot=0
# dnf5 needs-restarting -r exits 0 = no reboot needed, 1 = reboot needed;
# any other status means the check itself failed, so fall back to a kernel comparison.
rc=0
dnf5 needs-restarting -r >/dev/null 2>&1 || rc=$?
case "$rc" in
    0) ;;
    1) needs_reboot=1 ;;
    *)
        running_kernel="$(uname -r)"
        latest_kernel="$(rpm -q --last kernel-core 2>/dev/null | head -n1 | awk '{print $1}' | sed 's/^kernel-core-//')"
        if [[ -n "$latest_kernel" && "$running_kernel" != "$latest_kernel" ]]; then
            needs_reboot=1
        fi
        ;;
esac

if [[ "$needs_reboot" -eq 1 ]]; then
    log "A reboot is recommended (kernel or core libs changed)"
    reply=""
    if [[ -t 0 ]]; then
        read -rp "Reboot now? [y/N] " reply || true
    fi
    case "$reply" in
        [yY][eE][sS]|[yY])
            log "Rebooting"
            sudo systemctl reboot
            ;;
        *)
            echo "Skipping reboot — remember to do it manually."
            ;;
    esac
else
    log "No reboot needed"
fi

log "Done"
exit "$fedup_errors"
