#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
source "$HOME/.config/restic/restic-zenith.env"

: "${AWS_ACCESS_KEY_ID:?Set AWS_ACCESS_KEY_ID in restic-zenith.env}"
: "${AWS_SECRET_ACCESS_KEY:?Set AWS_SECRET_ACCESS_KEY in restic-zenith.env}"
: "${RESTIC_PASSWORD_FILE:?Set RESTIC_PASSWORD_FILE in restic-zenith.env}"
: "${RESTIC_REPOSITORY:?Set RESTIC_REPOSITORY in restic-zenith.env}"

exec restic "$@"
